<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="wordmark footer-wordmark">
        ECHO<span class="reg-mark">&reg;</span>
      </p>
      <p class="footer-copy">{{ section.settings.tagline }}</p>
    </div>

    <div class="footer-links">
      <a href="{{ routes.root_url }}">Overview</a>
      <a href="/pages/console">ECHO One</a>
      <a href="/pages/downloads">Downloads</a>
      <a href="/pages/support">Support</a>
      <a href="{{ routes.all_products_collection_url }}">Store</a>
      <a href="{{ routes.cart_url }}">Cart</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Footer Tagline",
      "default": "All your games. One console."
    }
  ]
}
{% endschema %}
